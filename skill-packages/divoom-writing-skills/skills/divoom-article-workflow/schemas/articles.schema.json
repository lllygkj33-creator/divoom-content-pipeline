{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:divoom:publisher-articles:v1",
  "title": "Divoom publisher blog array",
  "description": "Runtime workflow.py additionally enforces UTF-16 length, HTML, evidence and review freshness.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["blog title", "url", "meta title", "meta description", "summary", "author", "tags", "blog", "html代码"],
    "properties": {
      "blog title": {"type": "string", "minLength": 1},
      "url": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
      "meta title": {"type": "string", "minLength": 1},
      "meta description": {"type": "string", "minLength": 1, "maxLength": 160},
      "summary": {"type": "string", "minLength": 1, "maxLength": 160},
      "author": {"const": "Divoom Professional Team"},
      "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "blog": {"enum": ["Technology Hub", "Recommend & Comparison", "Support & Tips"]},
      "html代码": {"type": "string", "minLength": 1},
      "template": {"type": "string", "minLength": 1},
      "reviewer": {"type": "string", "minLength": 1},
      "related_products": {"type": "array", "items": {"type": "string", "minLength": 1}}
    }
  }
}
